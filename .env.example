# CafeHub Environment Configuration Example
# Copy this file to .env and configure your environment variables.
# NEVER commit the actual .env file or real secrets to Git.

# Secret key used for cryptographic session signing and CSRF protection
# In production, this must be set to a strong random value.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_real_secret

# Initial Admin Credentials
# Used only to initialize the first admin account when the database has no admin account.
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD=replace_with_strong_password

# Environment Mode ("development" or "production")
# In production, HTTPS-only secure cookies and strict error handling are enforced.
FLASK_ENV=development

# Server Port (defaults to 5000)
PORT=5000
